<?xml version='1.0' encoding='utf-8'?>
<robot name="uydu_mount">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="satellite.stl" />
      </geometry>
      <material name="satellite_grey">
        <color rgba=".6 .7 .8 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="satellite.stl" />
      </geometry>
    </collision>
  </link>
  <link name="uydu_mount" />
  <joint name="satellite_mount_fixed" type="fixed">
    <parent link="base_link" />
    <child link="uydu_mount" />
    <origin xyz="0.15 0.15 0.4046098543457654" rpy="0.0 0.0 0.0" />
  </joint>
  <link name="mount_support">
    <visual>
      <geometry>
        <mesh filename="mount_support.stl" />
      </geometry>
      <material name="mount_green">
        <color rgba=".2 .7 .35 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="mount_support.stl" />
      </geometry>
    </collision>
  </link>
  <joint name="support_fixed" type="fixed">
    <parent link="uydu_mount" />
    <child link="mount_support" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>